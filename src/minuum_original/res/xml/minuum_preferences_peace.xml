<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:title="@string/title_activity_minuum_settings" android:key="title_activity_minuum_settings"
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:minuum="http://schemas.android.com/apk/res/com.whirlscape.minuumfree">
    <Preference android:icon="@drawable/prefs_icon_share" android:title="@string/preferences_settings_share_title" android:key="settings_share" />
    <PreferenceCategory android:title="@string/preferences_howto_category_settings_title">
        <Preference android:icon="@drawable/prefs_icon_tutorial" android:title="@string/preferences_minuum_tutorial_title" android:key="minuum_tutorial" />
        <com.whirlscape.patch.PatchedSwitchPreference android:title="Enable extracted text" android:key="extract_text_enabled" android:summary="Use extracted text whenever possible" android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/preferences_settings_category_looknfeel_title">
        <Preference android:summary="@string/preferences_looknfeel_blurb" />
        <com.whirlscape.patch.PatchedSwitchPreference android:title="@string/preferences_show_spacebar_title" android:key="show_spacebar" android:summary="@string/preferences_show_spacebar_summary" android:defaultValue="true" />
        <com.whirlscape.patch.PatchedSwitchPreference android:title="@string/preferences_gestures_enable_title" android:key="gesture_enable" android:summary="@string/preferences_gestures_enable_summary" android:dependency="show_spacebar" android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/preferences_settings_category_sizing_title">
        <com.whirlscape.minuum.ui.SeekBarPreference android:persistent="true" android:title="@string/preferences_candidates_height_title" android:key="candidates_height" android:summary="@string/preferences_candidate_height_summary" android:defaultValue="80" android:dialogTitle="@string/preferences_candidates_height_dialog_title" minuum:minValue="60" minuum:maxValue="160" />
        <com.whirlscape.minuum.ui.SeekBarPreference android:persistent="true" android:title="@string/preferences_spacebar_height_title" android:key="spacebar_height" android:summary="@string/preferences_spacebar_height_summary" android:dependency="show_spacebar" android:defaultValue="80" android:dialogTitle="@string/preferences_spacebar_height_dialog_title" minuum:minValue="60" minuum:maxValue="160" />
        <com.whirlscape.minuum.ui.SeekBarPreference1D android:persistent="true" android:title="@string/preferences_keyboard_height_title" android:key="keyboard_height" android:summary="@string/preferences_keyboard_height_summary" android:defaultValue="145" android:dialogTitle="@string/preferences_keyboard_height_dialog_title" minuum:minValue="80" minuum:maxValue="200" />
        <com.whirlscape.minuum.ui.SeekBarPreference2D android:persistent="true" android:title="@string/preferences_keyboard_height_2d_title" android:key="keyboard_height_2d" android:summary="@string/preferences_keyboard_height_2d_summary" android:defaultValue="300" android:dialogTitle="@string/preferences_keyboard_height_2d_dialog_title" minuum:minValue="150" minuum:maxValue="600" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/preferences_settings_category_vibrate_title">
        <com.whirlscape.minuum.ui.SeekBarPreference android:persistent="true" android:title="@string/preferences_vibrate_on_keypress_title" android:key="vibrate_on_keypress" android:summary="@string/preferences_vibrate_on_keypress_summary" android:defaultValue="5" android:dialogTitle="@string/preferences_vibrate_on_keypress_dialog_title" minuum:minValue="0" minuum:maxValue="100" minuum:units=" ms" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/preferences_settings_category_sound_title">
        <com.whirlscape.minuum.ui.SeekBarPreference android:persistent="true" android:title="@string/preferences_sound_on_keypress_title" android:key="sound_on_keypress" android:summary="@string/preferences_sound_on_keypress_summary" android:defaultValue="80" android:dialogTitle="@string/preferences_sound_on_keypress_dialog_title" minuum:minValue="0" minuum:maxValue="100" minuum:units="%" />
        <ListPreference android:entries="@array/sound_set_names" android:title="@string/preferences_sound_set_title" android:key="sound_set_select" android:summary="@string/preferences_sound_set_summary" android:defaultValue="pockpock" android:entryValues="@array/sound_set_values" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/preferences_settings_category_layout_title">
        <ListPreference android:entries="@array/layout_names" android:title="@string/preferences_layout_title" android:key="layout_select" android:summary="@string/preferences_layout_summary" android:defaultValue="qwerty" android:entryValues="@array/layout_values" />
        <ListPreference android:entries="@array/currency_names" android:title="@string/preferences_currency_title" android:key="currency_select" android:summary="@string/preferences_currency_summary" android:defaultValue="auto" android:entryValues="@array/currency_values" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/preferences_settings_category_language_title">
        <Preference android:title="@string/preferences_language_download_title" android:summary="@string/preferences_language_download_summary">
            <intent android:targetPackage="com.whirlscape.minuum" android:targetClass="com.whirlscape.minuum.LanguageDownloadActivity" />
        </Preference>
        <com.whirlscape.patch.PatchedSwitchPreference android:title="@string/preferences_is_fast_language_switching_title" android:key="is_fast_language_switching" android:summary="@string/preferences_is_fast_language_switching_summary" android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/preferences_settings_category_import_title">
        <Preference android:title="@string/preferences_dict_load_title" android:key="dict_load" android:summary="@string/preferences_dict_load_summary" />
        <Preference android:title="@string/preferences_contact_load_title" android:key="contact_load" android:summary="@string/preferences_contact_load_summary" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/preferences_settings_category_manage_title">
        <Preference android:title="@string/preferences_export_mutable_title" android:key="export_mutable" android:summary="@string/preferences_export_mutable_summary" />
        <Preference android:title="@string/preferences_import_mutable_title" android:key="import_mutable" android:summary="@string/preferences_import_mutable_summary" />
        <Preference android:title="@string/preferences_reset_mutable_title" android:key="reset_mutable" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/preferences_settings_category_versionname_title">
        <Preference android:icon="@drawable/prefs_icon_twitter" android:title="@string/preferences_follow_minuum_title" android:key="twitter" />
        <Preference android:icon="@drawable/prefs_icon_updates" android:title="@string/mailing_list_pref_title" android:key="mailing_list" android:summary="@string/mailing_list_pref_summary" />
        <Preference android:icon="@drawable/prefs_icon_support" android:title="@string/preferences_support_title" android:key="support" android:summary="@string/preferences_support_summary" />
        <Preference android:icon="@drawable/prefs_icon_reset_prefs" android:title="@string/preferences_reset_prefs_title" android:key="reset_prefs" />
    </PreferenceCategory>
    <PreferenceScreen android:icon="@drawable/prefs_icon_devil" android:title="Development" android:key="development">
        <CheckBoxPreference android:title="@string/is_floating" android:key="is_floating" android:summary="@string/is_floating_summary" android:defaultValue="false" />
        <com.whirlscape.patch.PatchedSwitchPreference android:title="@string/is_stretchy" android:key="is_stretchy" android:summary="@string/is_stretchy_summary" android:defaultValue="false" />
        <Preference android:title="Days remaining popup" android:key="days_remaining_popup" />
        <Preference android:title="What country?" android:key="what_country" android:summary="Prints to logcat" />
        <Preference android:title="@string/dump_files" android:key="dump_files" android:summary="@string/dump_files_summ" android:defaultValue="false" />
        <Preference android:title="Rating Nag" android:key="trigger_rating_nag" android:summary="Triggers the rating nag" />
        <Preference android:title="Mailing Nag" android:key="trigger_mailing_nag" android:summary="Triggers the mailing nag" />
        <Preference android:title="Complete purchase" android:key="trigger_completed_purchase" android:summary="Simulates a completed purchase" />
        <Preference android:title="Reset Purchases" android:key="reset_purchases" android:summary="Clears all purchases associated with this account" />
        <Preference android:title="Reset Announcement" android:key="reset_announcement" android:summary="Announcement will open next time keyboard opens" />
        <Preference android:title="Rate" android:key="trigger_rate" android:summary="Sends the user to rate the app" />
        <Preference android:title="Crash" android:key="trigger_crash" android:summary="Minuum will now crash! Yay!" />
        <Preference android:title="Tutorial function tester" android:key="disable_tester" android:summary="Interface for testing tutorial functions" />
        <Preference android:title="Popup Tutorial" android:key="popup_tutorial" android:summary="Moving to production soon!" />
        <Preference android:title="Print UsageTracker Report" android:key="print_ut_report" android:summary="Print event summary from UsageTracker" />
        <Preference android:title="Set as new" android:key="set_as_new" android:summary="To test the tutorial and EULA" />
        <Preference android:title="Pick Color" android:key="color_picker" android:summary="To pick a color for the keyboard themes" />
    </PreferenceScreen>
</PreferenceScreen>